import Mathlib

/-!
# Concrete Monomial-Product Taylor Family (Defect D1, Part 1 — Eliminates `canonicalMonomialTaylorFamily`)

This file constructs the exact cleared-denominator integer Taylor series of the monomial-product
family
$$\Omega_{\mathbf{e}}(x) = \prod_{i=1}^d \prod_{j=1}^{\beta_i - 1} (1 - j x)^{-e_i / r}$$
for $|\mathbf{e}| \le E \le r - 1$ directly in Mathlib's `PowerSeries ℤ` with **zero external axioms**:
- `multiIndexFinset` & `card_multiIndexFinset`: proves `#{\mathbf{e} \in \{0, \dots, E\}^d : |\mathbf{e}| \le E} = \binom{d+E}{d}$
- `multiIndexEquiv`: canonical bijection `Fin (Nat.choose (d + E) d) ≃ multiIndexFinset d E`
  sending `0 ↦ fun _ => 0`
- `factorial_dvd_r_pow_mul_pochhammer`: elementary prime-by-prime proof that
  $k! \mid r^k \prod_{u=0}^{k-1} (e + u r)$ for all $e, k \in \mathbb{N}$ and $r \ge 1$
- `clearedFactorSeries`, `clearedMonomialSeries`: exact `PowerSeries ℤ` representing
  $\Omega_{\mathbf{e}}(r^2 x)$ with non-negative integer coefficients
- `clearedMonomialSeries_coeff_le`: proves $0 \le r^{2k} c_{\mathbf{e}, k} \le (r^2 \cdot (d M) \cdot M)^k$
- `canonicalMonomialTaylorFamily`: **concrete `def`** (replacing the former axiom) returning
  `AlgebraicTaylorFamily (Nat.choose (d + E) d - 1) r M`.
-/

noncomputable section

open scoped BigOperators
open Finset

namespace GrasGreenbergBrocard

/-- Taylor-series and denominator-clearing data for a family of $m + 1$ algebraic functions
$f_0, \dots, f_m$ of root order $r \ge 2$ generated by integer shifts $0 < \beta_1 < \dots < \beta_d \le M$
(Bui–Pratt–Zaharescu 2023, Lemma 4.2). -/
structure AlgebraicTaylorFamily (m r M : ℕ) where
  C_P : ℝ
  C_P_pos : 1 ≤ C_P
  /-- Cleared integer Taylor coefficients $r^{2k} c_{i, k} \in \mathbb{Z}$ for $0 \le i \le m$, $k \ge 0$. -/
  clearedCoeff : Fin (m + 1) → ℕ → ℤ
  /-- For $i = 0$, $f_0(x) = 1$, so $c_{0, 0} = 1$ and $c_{0, k} = 0$ for $k \ge 1$. -/
  f0_eq_one : clearedCoeff 0 0 = 1 ∧ ∀ k : ℕ, 1 ≤ k → clearedCoeff 0 k = 0
  /-- Coefficient bound $|r^{2k} c_{i, k}| \le (r^2 C_P M)^k$. -/
  coeff_bound : ∀ (i : Fin (m + 1)) (k : ℕ),
    |(clearedCoeff i k : ℝ)| ≤ ((r : ℝ) ^ 2 * C_P * (M : ℝ)) ^ k

/-! ### Multi-Index Enumeration: `#{\mathbf{e} : |\mathbf{e}| ≤ E} = \binom{d + E}{d}` -/

/-- The finite set of multi-indices `e : Fin d → ℕ` with `∑ i, e i ≤ E`. -/
def multiIndexFinset (d E : ℕ) : Finset (Fin d → ℕ) :=
  (Fintype.piFinset (fun _ : Fin d => Finset.range (E + 1))).filter (fun e => ∑ i, e i ≤ E)

lemma zero_mem_multiIndexFinset (d E : ℕ) : (fun _ : Fin d => 0) ∈ multiIndexFinset d E := by
  unfold multiIndexFinset
  simp

/-- Stars-and-bars cardinality: `(multiIndexFinset d E).card = Nat.choose (d + E) d`. -/
theorem card_multiIndexFinset (d : ℕ) :
    ∀ E : ℕ, (multiIndexFinset d E).card = Nat.choose (d + E) d := by
  induction d with
  | zero =>
    intro E
    have huniv : multiIndexFinset 0 E = {Fin.elim0} := by
      ext e
      simp only [multiIndexFinset, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_singleton]
      constructor
      · intro _; funext i; exact i.elim0
      · rintro rfl; exact ⟨fun i => i.elim0, by simp⟩
    rw [huniv, Finset.card_singleton, Nat.choose_zero_right]
  | succ d ih =>
    intro E
    -- Partition `multiIndexFinset (d + 1) E` by the last coordinate `c = e (Fin.last d) ∈ range (E + 1)`
    have hcard_eq : (multiIndexFinset (d + 1) E).card =
        ∑ c ∈ Finset.range (E + 1), (multiIndexFinset d (E - c)).card := by
      rw [← Finset.card_sigma]
      refine Finset.card_bij (fun e _ => ⟨e (Fin.last d), Fin.init e⟩) ?_ ?_ ?_
      · intro e he
        simp only [multiIndexFinset, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_range] at he
        have hsum : (∑ i : Fin d, Fin.init e i) + e (Fin.last d) = ∑ i : Fin (d + 1), e i :=
          (Fin.sum_univ_castSucc e).symm
        refine Finset.mem_sigma.mpr ⟨Finset.mem_range.mpr (he.1 (Fin.last d)), ?_⟩
        simp only [multiIndexFinset, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_range]
        refine ⟨fun i => ?_, by omega⟩
        have hle : Fin.init e i ≤ ∑ j : Fin d, Fin.init e j :=
          Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
        omega
      · intro e₁ _ e₂ _ h
        have hc : e₁ (Fin.last d) = e₂ (Fin.last d) := congrArg Sigma.fst h
        have hinit : Fin.init e₁ = Fin.init e₂ := by
          have := congrArg Sigma.snd h
          simpa using eq_of_heq (by simpa [hc] using this)
        funext i
        refine Fin.lastCases hc (fun j => ?_) i
        have := congrFun hinit j
        simpa [Fin.init] using this
      · rintro ⟨c, e'⟩ hmem
        rcases Finset.mem_sigma.mp hmem with ⟨hc, he'⟩
        simp only [Finset.mem_range] at hc
        simp only [multiIndexFinset, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_range] at he'
        refine ⟨Fin.snoc e' c, ?_, ?_⟩
        · simp only [multiIndexFinset, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_range]
          refine ⟨fun i => ?_, ?_⟩
          · refine Fin.lastCases ?_ (fun j => ?_) i
            · simpa using hc
            · simp only [Fin.snoc_castSucc]; have := he'.1 j; omega
          · rw [Fin.sum_univ_castSucc]; simp only [Fin.snoc_castSucc, Fin.snoc_last]; omega
        · ext
          · simp
          · simp [Fin.init_snoc]
    rw [hcard_eq]
    have hsum_ih : ∑ c ∈ Finset.range (E + 1), (multiIndexFinset d (E - c)).card =
        ∑ k ∈ Finset.range (E + 1), Nat.choose (d + k) d := by
      have h1 : ∑ c ∈ Finset.range (E + 1), (multiIndexFinset d (E - c)).card =
          ∑ c ∈ Finset.range (E + 1), Nat.choose (d + (E - c)) d :=
        Finset.sum_congr rfl (fun c _ => ih (E - c))
      rw [h1]
      rw [← Finset.sum_range_reflect (fun k => Nat.choose (d + k) d) (E + 1)]
      apply Finset.sum_congr rfl
      intro c hc
      have : c < E + 1 := Finset.mem_range.mp hc
      simp only [Nat.add_sub_cancel, show E + 1 - 1 - c = E - c by omega]
    rw [hsum_ih]
    -- Hockey-stick identity: `∑ k ∈ range (E + 1), choose (d + k) d = choose (d + 1 + E) (d + 1)`
    clear ih hcard_eq hsum_ih
    induction E with
    | zero => simp
    | succ E ihE =>
      rw [Finset.sum_range_succ, ihE, show d + 1 + (E + 1) = (d + 1 + E) + 1 by omega,
        Nat.choose_succ_succ, show d + (E + 1) = d + 1 + E by omega]
      ring

/-- Canonical bijection `Fin (Nat.choose (d + E) d) ≃ multiIndexFinset d E` sending `0` to the
zero multi-index `fun _ => 0`. -/
def multiIndexEquiv (d E : ℕ) :
    Fin (Nat.choose (d + E) d) ≃ {e : Fin d → ℕ // e ∈ multiIndexFinset d E} :=
  let hpos : 0 < Nat.choose (d + E) d := Nat.choose_pos (by omega)
  let e0 : Fin (Nat.choose (d + E) d) ≃ {e : Fin d → ℕ // e ∈ multiIndexFinset d E} :=
    (Fintype.equivFinOfCardEq (by simp [card_multiIndexFinset d E])).symm
  let zeroIdx : Fin (Nat.choose (d + E) d) := e0.symm ⟨fun _ => 0, zero_mem_multiIndexFinset d E⟩
  let z0 : Fin (Nat.choose (d + E) d) := ⟨0, hpos⟩
  (Equiv.swap z0 zeroIdx).trans e0

lemma multiIndexEquiv_zero (d E : ℕ) :
    (multiIndexEquiv d E ⟨0, Nat.choose_pos (by omega)⟩).val = fun _ => 0 := by
  unfold multiIndexEquiv
  simp

/-! ### Elementary Integrality of Cleared Fractional Binomial Coefficients -/

/-- Rising-progression product `∏_{u=0}^{k-1} (e + u * r)`. -/
def pochhammerInt (e r k : ℕ) : ℕ :=
  ∏ u ∈ Finset.range k, (e + u * r)

lemma pochhammerInt_zero_k (e r : ℕ) : pochhammerInt e r 0 = 1 := by
  simp [pochhammerInt]

lemma pochhammerInt_zero_e {r k : ℕ} (hk : 1 ≤ k) : pochhammerInt 0 r k = 0 := by
  unfold pochhammerInt
  apply Finset.prod_eq_zero (i := 0) (Finset.mem_range.mpr hk)
  simp

/-- Telescoping Legendre bound: `(p - 1) * v_p(k!) ≤ k` for every prime `p` and `k : ℕ`. -/
lemma padicValNat_factorial_le_self {p k : ℕ} (hp : p.Prime) :
    padicValNat p (Nat.factorial k) ≤ k := by
  haveI : Fact p.Prime := ⟨hp⟩
  by_cases hk0 : k = 0
  · subst hk0; simp
  have hlog : Nat.log p k < k + 1 :=
    Nat.log_lt_of_lt_pow hk0
      (lt_trans (Nat.lt_pow_self hp.one_lt) (Nat.pow_lt_pow_right hp.one_lt (Nat.lt_succ_self k)))
  rw [padicValNat_factorial hlog]
  have htele : ∀ b : ℕ, ∑ i ∈ Finset.Ico 1 (b + 1), k / p ^ i ≤ k - k / p ^ b := by
    intro b
    induction b with
    | zero => simp
    | succ b ih =>
      rw [Finset.sum_Ico_succ_top (by omega : 1 ≤ b + 1)]
      have hdiv_step : k / p ^ (b + 1) + k / p ^ (b + 1) ≤ k / p ^ b := by
        have h2p : 2 ≤ p := hp.two_le
        have h1 : k / p ^ (b + 1) = (k / p ^ b) / p := by
          rw [pow_succ, Nat.div_div_eq_div_mul]
        rw [h1]
        have h2 : p * ((k / p ^ b) / p) ≤ k / p ^ b := Nat.mul_div_le _ _
        have h3 : 2 * ((k / p ^ b) / p) ≤ p * ((k / p ^ b) / p) := Nat.mul_le_mul_right _ h2p
        omega
      have hle_k : k / p ^ b ≤ k := Nat.div_le_self k _
      omega
  exact le_trans (htele k) (Nat.sub_le _ _)

/-- **Elementary Denominator-Clearing Divisibility**:
For every `e, k : ℕ` and `r ≥ 1`, `k! ∣ r^k * ∏_{u=0}^{k-1} (e + u * r)`. -/
theorem factorial_dvd_r_pow_mul_pochhammer (e r k : ℕ) (hr : 1 ≤ r) :
    Nat.factorial k ∣ r ^ k * pochhammerInt e r k := by
  by_cases he0 : e = 0
  · subst he0
    rcases eq_or_ne k 0 with rfl | hk0
    · simp [pochhammerInt]
    · rw [pochhammerInt_zero_e (Nat.pos_of_ne_zero hk0), mul_zero]; exact dvd_zero _
  have hprod_pos : 0 < r ^ k * pochhammerInt e r k := by
    apply Nat.mul_pos (pow_pos (by omega) k)
    unfold pochhammerInt
    exact Finset.prod_pos (fun u _ => by omega)
  rw [← Nat.factorization_le_iff_dvd (Nat.factorial_ne_zero k) hprod_pos.ne']
  intro p
  by_cases hp : p.Prime
  · haveI : Fact p.Prime := ⟨hp⟩
    rw [Nat.factorization_def _ hp, Nat.factorization_def _ hp]
    by_cases hpr : p ∣ r
    · -- Case 1: p ∣ r ⇒ v_p(r^k) ≥ k ≥ v_p(k!)
      have hpoch_pos : 0 < pochhammerInt e r k := Finset.prod_pos (fun u _ => by omega)
      rw [padicValNat.mul (pow_ne_zero k (by omega)) hpoch_pos.ne', padicValNat.pow k (by omega)]
      have hvr : 1 ≤ padicValNat p r := one_le_padicValNat_of_dvd (by omega) hpr
      have hfac := padicValNat_factorial_le_self (k := k) hp
      nlinarith
    · -- Case 2: p ∤ r ⇒ invert r mod p^v where v = v_p(k!)
      set v := padicValNat p (Nat.factorial k)
      have hcop : Nat.Coprime r (p ^ v) := (hp.coprime_iff_not_dvd.mpr hpr).symm.pow_right v
      -- Find c ∈ ℕ with r * c ≡ e [MOD p^v]
      have hbez : ∃ c : ℕ, (r * c) % p ^ v = e % p ^ v := by
        rcases eq_or_ne v 0 with hv0 | hv0
        · refine ⟨0, ?_⟩; simp [hv0, Nat.mod_one]
        have hpv_pos : 0 < p ^ v := pow_pos hp.pos v
        haveI : NeZero (p ^ v) := ⟨hpv_pos.ne'⟩
        let rinv : ZMod (p ^ v) := (ZMod.unitOfCoprime r hcop : (ZMod (p ^ v))ˣ)⁻¹
        let c : ℕ := ((e : ZMod (p ^ v)) * rinv).val
        refine ⟨c, ?_⟩
        change (r * c) ≡ e [MOD p ^ v]
        rw [← ZMod.natCast_eq_natCast_iff, Nat.cast_mul]
        dsimp only [c]
        rw [ZMod.natCast_zmod_val, mul_comm (r : ZMod (p ^ v)), mul_assoc]
        have hmul1 : rinv * (r : ZMod (p ^ v)) = 1 := by
          dsimp only [rinv]
          have h1 : ((ZMod.unitOfCoprime r hcop : (ZMod (p ^ v))ˣ) : ZMod (p ^ v)) = (r : ZMod (p ^ v)) :=
            ZMod.coe_unitOfCoprime r hcop
          rw [← h1]
          exact Units.inv_mul _
        rw [hmul1, mul_one]
      obtain ⟨c, hc⟩ := hbez
      -- Now `∏_{u=0}^{k-1} (e + u*r) ≡ r^k * ∏_{u=0}^{k-1} (c + u) [MOD p^v]`
      have hmod_prod : pochhammerInt e r k ≡ r ^ k * (∏ u ∈ Finset.range k, (c + u)) [MOD p ^ v] := by
        unfold pochhammerInt
        have hpow_prod : r ^ k * (∏ u ∈ Finset.range k, (c + u)) =
            ∏ u ∈ Finset.range k, (r * c + u * r) := by
          rw [show r ^ k = ∏ _u ∈ Finset.range k, r by simp, ← Finset.prod_mul_distrib]
          apply Finset.prod_congr rfl; intro u _; ring
        rw [hpow_prod]
        have haux : ∀ m : ℕ, ∏ u ∈ Finset.range m, (e + u * r) ≡
            ∏ u ∈ Finset.range m, (r * c + u * r) [MOD p ^ v] := by
          intro m
          induction m with
          | zero => simp [Nat.ModEq]
          | succ m ihm =>
            rw [Finset.prod_range_succ, Finset.prod_range_succ]
            exact Nat.ModEq.mul ihm (Nat.ModEq.add_right (m * r) hc.symm)
        exact haux k
      -- Since `k! ∣ ∏_{u=0}^{k-1} (c + u)`, `p^v ∣ ∏_{u=0}^{k-1} (c + u)`
      have hfac_dvd_asc : Nat.factorial k ∣ ∏ u ∈ Finset.range k, (c + u) := by
        cases c with
        | zero =>
          cases k with
          | zero => simp
          | succ k' =>
            have h0 : ∏ u ∈ Finset.range (k' + 1), (0 + u) = 0 :=
              Finset.prod_eq_zero (Finset.mem_range.mpr (Nat.succ_pos k')) (by simp)
            rw [h0]; exact dvd_zero _
        | succ c' =>
          have heq : ∀ m : ℕ, ∏ u ∈ Finset.range m, (c' + 1 + u) =
              Nat.factorial m * Nat.choose (c' + m) m := by
            intro m
            induction m with
            | zero => simp
            | succ m ihm =>
              rw [Finset.prod_range_succ, ihm, Nat.factorial_succ]
              have hch := Nat.add_one_mul_choose_eq (c' + m) m
              have h1 : c' + (m + 1) = c' + m + 1 := by omega
              rw [h1]
              nlinarith
          rw [heq k]
          exact dvd_mul_right _ _
      have hpv_dvd_asc : p ^ v ∣ ∏ u ∈ Finset.range k, (c + u) :=
        dvd_trans pow_padicValNat_dvd hfac_dvd_asc
      have hpv_dvd_poch : p ^ v ∣ pochhammerInt e r k := by
        have h0 : p ^ v ∣ r ^ k * (∏ u ∈ Finset.range k, (c + u)) := dvd_mul_of_dvd_right hpv_dvd_asc _
        exact (Nat.ModEq.dvd_iff hmod_prod.symm dvd_rfl).mp h0
      have hpv_dvd_tot : p ^ v ∣ r ^ k * pochhammerInt e r k := dvd_mul_of_dvd_right hpv_dvd_poch _
      exact (padicValNat_dvd_iff_le hprod_pos.ne').mp hpv_dvd_tot
  · rw [Nat.factorization_eq_zero_of_not_prime _ hp, Nat.factorization_eq_zero_of_not_prime _ hp]

/-- Upper bound on `pochhammerInt`: for `e ≤ r`, `pochhammerInt e r k ≤ r^k * k!`. -/
lemma pochhammerInt_le_pow_mul_factorial {e r k : ℕ} (her : e ≤ r) :
    pochhammerInt e r k ≤ r ^ k * Nat.factorial k := by
  unfold pochhammerInt
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Finset.prod_range_succ, pow_succ, Nat.factorial_succ]
    have hstep : e + k * r ≤ r * (k + 1) := by nlinarith
    calc (∏ u ∈ Finset.range k, (e + u * r)) * (e + k * r)
        ≤ (r ^ k * Nat.factorial k) * (r * (k + 1)) := Nat.mul_le_mul ih hstep
      _ = r ^ k * r * ((k + 1) * Nat.factorial k) := by ring

/-- Exact cleared integer `k`-th Taylor coefficient of `(1 - j x)^{-e / r}`, scaled by `r^{2k}`:
`clearedFactorCoeff e r j k = (r^k * pochhammerInt e r k / k!) * j^k`. -/
def clearedFactorCoeff (e r j k : ℕ) : ℕ :=
  (r ^ k * pochhammerInt e r k / Nat.factorial k) * j ^ k

lemma clearedFactorCoeff_zero_k (e r j : ℕ) : clearedFactorCoeff e r j 0 = 1 := by
  simp [clearedFactorCoeff, pochhammerInt]

lemma clearedFactorCoeff_zero_e {r j k : ℕ} (hk : 1 ≤ k) : clearedFactorCoeff 0 r j k = 0 := by
  simp [clearedFactorCoeff, pochhammerInt_zero_e hk]

lemma clearedFactorCoeff_le {e r j M k : ℕ} (her : e ≤ r) (hj : j ≤ M) :
    clearedFactorCoeff e r j k ≤ (r ^ 2 * M) ^ k := by
  unfold clearedFactorCoeff
  have hdiv : r ^ k * pochhammerInt e r k / Nat.factorial k ≤ r ^ k * r ^ k := by
    apply Nat.div_le_of_le_mul
    calc r ^ k * pochhammerInt e r k
        ≤ r ^ k * (r ^ k * Nat.factorial k) := Nat.mul_le_mul_left _ (pochhammerInt_le_pow_mul_factorial her)
      _ = Nat.factorial k * (r ^ k * r ^ k) := by ring
  calc (r ^ k * pochhammerInt e r k / Nat.factorial k) * j ^ k
      ≤ (r ^ k * r ^ k) * M ^ k := Nat.mul_le_mul hdiv (Nat.pow_le_pow_left hj k)
    _ = (r ^ 2 * M) ^ k := by rw [mul_pow, ← pow_mul, show 2 * k = k + k by omega, pow_add]

/-- Cleared integer formal power series representing `(1 - j r^2 x)^{-e / r}` in `PowerSeries ℤ`. -/
def clearedFactorSeries (e r j : ℕ) : PowerSeries ℤ :=
  PowerSeries.mk (fun k => (clearedFactorCoeff e r j k : ℤ))

lemma clearedFactorSeries_zero_e (r j : ℕ) : clearedFactorSeries 0 r j = 1 := by
  ext k
  cases k with
  | zero => simp [clearedFactorSeries, clearedFactorCoeff_zero_k]
  | succ k => simp [clearedFactorSeries, clearedFactorCoeff_zero_e (Nat.succ_pos k)]

/-- Cleared integer formal power series representing
`Ω_e(r^2 x) = ∏_{i=0}^{d-1} ∏_{j=1}^{β_i - 1} (1 - j r^2 x)^{-e_i / r}` in `PowerSeries ℤ`. -/
def clearedMonomialSeries {d : ℕ} (r : ℕ) (β : Fin d → ℕ) (e : Fin d → ℕ) : PowerSeries ℤ :=
  ∏ i : Fin d, ∏ j ∈ Finset.Ico 1 (β i), clearedFactorSeries (e i) r j

lemma clearedMonomialSeries_zero {d : ℕ} (r : ℕ) (β : Fin d → ℕ) :
    clearedMonomialSeries r β (fun _ => 0) = 1 := by
  unfold clearedMonomialSeries
  apply Finset.prod_eq_one; intro i _
  apply Finset.prod_eq_one; intro j _
  exact clearedFactorSeries_zero_e r j

/-- Binomial majorization helper: `Nat.choose (k + L) k ≤ (L + 1) ^ k` for all `k, L : ℕ`. -/
private lemma choose_add_le_pow (L k : ℕ) : Nat.choose (k + L) k ≤ (L + 1) ^ k := by
  induction k with
  | zero => simp
  | succ k ih =>
    have hmul : (k + 1) * Nat.choose (k + 1 + L) (k + 1) = (k + 1 + L) * Nat.choose (k + L) k := by
      have h := Nat.add_one_mul_choose_eq (k + L) k
      have heq : k + 1 + L = k + L + 1 := by omega
      rw [heq]; linarith
    have hstep : k + 1 + L ≤ (k + 1) * (L + 1) := by nlinarith
    have hle : (k + 1) * Nat.choose (k + 1 + L) (k + 1) ≤ (k + 1) * ((L + 1) ^ (k + 1)) := by
      calc (k + 1) * Nat.choose (k + 1 + L) (k + 1)
          = (k + 1 + L) * Nat.choose (k + L) k := hmul
        _ ≤ ((k + 1) * (L + 1)) * (L + 1) ^ k := Nat.mul_le_mul hstep ih
        _ = (k + 1) * ((L + 1) ^ (k + 1)) := by rw [pow_succ']; ring
    exact Nat.le_of_mul_le_mul_left hle (Nat.succ_pos k)

/-- Product majorization for `PowerSeries ℤ` with non-negative coefficients bounded by `A^k`:
if each factor `f ∈ s` has `0 ≤ coeff k f ≤ A^k`, then `0 ≤ coeff k (∏ f ∈ s, f) ≤ (s.card * A)^k`
(for `s.card ≥ 1`; and `≤ 1` for `s = ∅`). -/
private lemma powerSeries_prod_coeff_bound {ι : Type*} (s : Finset ι) (f : ι → PowerSeries ℤ)
    (A : ℕ) (hf : ∀ a ∈ s, ∀ k : ℕ, 0 ≤ PowerSeries.coeff k (f a) ∧
      PowerSeries.coeff k (f a) ≤ ((A : ℤ) ^ k)) :
    ∀ k : ℕ, 0 ≤ PowerSeries.coeff k (∏ a ∈ s, f a) ∧
      PowerSeries.coeff k (∏ a ∈ s, f a) ≤
        ((Nat.choose (k + s.card) k : ℕ) : ℤ) * (A : ℤ) ^ k := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro k
    cases k with
    | zero => simp
    | succ k => simp
  | @insert a s ha ih =>
    intro k
    rw [Finset.prod_insert ha, PowerSeries.coeff_mul]
    have hfa := hf a (Finset.mem_insert_self a s)
    have ih' := ih (fun b hb => hf b (Finset.mem_insert_of_mem hb))
    constructor
    · apply Finset.sum_nonneg
      rintro ⟨p, q⟩ _
      exact mul_nonneg (hfa p).1 (ih' q).1
    · calc ∑ x ∈ Finset.Nat.antidiagonal k, PowerSeries.coeff x.1 (f a) * PowerSeries.coeff x.2 (∏ b ∈ s, f b)
          ≤ ∑ x ∈ Finset.Nat.antidiagonal k,
              (A : ℤ) ^ x.1 * (((Nat.choose (x.2 + s.card) x.2 : ℕ) : ℤ) * (A : ℤ) ^ x.2) := by
            apply Finset.sum_le_sum
            rintro ⟨p, q⟩ _
            exact mul_le_mul (hfa p).2 (ih' q).2 (ih' q).1 (by positivity)
        _ = (∑ x ∈ Finset.Nat.antidiagonal k, ((Nat.choose (x.2 + s.card) x.2 : ℕ) : ℤ)) * (A : ℤ) ^ k := by
            rw [Finset.sum_mul]
            apply Finset.sum_congr rfl
            rintro ⟨p, q⟩ hpq
            have hadd : p + q = k := Finset.Nat.mem_antidiagonal.mp hpq
            rw [← hadd, pow_add]; ring
        _ = ((Nat.choose (k + (insert a s).card) k : ℕ) : ℤ) * (A : ℤ) ^ k := by
            congr 1
            rw [Finset.card_insert_of_notMem ha]
            -- `∑ (p, q) ∈ antidiagonal k, choose (q + s.card) q = choose (k + (s.card + 1)) k`
            have hsum_anti : ∑ x ∈ Finset.Nat.antidiagonal k, Nat.choose (x.2 + s.card) x.2 =
                ∑ q ∈ Finset.range (k + 1), Nat.choose (q + s.card) q := by
              rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ (fun _ q => Nat.choose (q + s.card) q)]
              rw [← Finset.sum_range_reflect (fun q => Nat.choose (q + s.card) q) (k + 1)]
              apply Finset.sum_congr rfl
              intro i hi
              have : i < k + 1 := Finset.mem_range.mp hi
              simp [show k + 1 - 1 - i = k - i by omega]
            have hhockey : ∑ q ∈ Finset.range (k + 1), Nat.choose (q + s.card) q =
                Nat.choose (k + (s.card + 1)) k := by
              clear hsum_anti ih ih' hfa hf ha f A a
              induction k with
              | zero => simp
              | succ k ihk =>
                rw [Finset.sum_range_succ, ihk,
                  show k + 1 + (s.card + 1) = (k + (s.card + 1)) + 1 by omega,
                  Nat.choose_succ_succ, show k + 1 + s.card = k + (s.card + 1) by omega]
                ring
            exact_mod_cast (hsum_anti.trans hhockey)

/-- **Exact Coefficient Bound for `clearedMonomialSeries`**:
For `e i ≤ r` and `β i ≤ M`, every Taylor coefficient of `clearedMonomialSeries r β e` is
non-negative and bounded by `(r^2 * (d * M + 1) * M)^k`. -/
theorem clearedMonomialSeries_coeff_bound {d r M : ℕ} (β e : Fin d → ℕ)
    (hβ_hi : ∀ i, β i ≤ M) (he_le : ∀ i, e i ≤ r) (k : ℕ) :
    0 ≤ PowerSeries.coeff k (clearedMonomialSeries r β e) ∧
    |((PowerSeries.coeff k (clearedMonomialSeries r β e) : ℤ) : ℝ)| ≤
      ((r : ℝ) ^ 2 * ((d * M + 1 : ℕ) : ℝ) * (M : ℝ)) ^ k := by
  let S : Finset (Σ _ : Fin d, ℕ) := Finset.univ.sigma (fun i => Finset.Ico 1 (β i))
  have hprod_eq : clearedMonomialSeries r β e =
      ∏ p ∈ S, clearedFactorSeries (e p.1) r p.2 := by
    unfold clearedMonomialSeries
    exact (Finset.prod_sigma Finset.univ (fun i => Finset.Ico 1 (β i))
      (fun p => clearedFactorSeries (e p.1) r p.2)).symm
  have hfac_bd : ∀ p ∈ S, ∀ n : ℕ,
      0 ≤ PowerSeries.coeff n (clearedFactorSeries (e p.1) r p.2) ∧
      PowerSeries.coeff n (clearedFactorSeries (e p.1) r p.2) ≤ ((r ^ 2 * M : ℕ) : ℤ) ^ n := by
    intro p hp n
    have hp2 : p.2 ∈ Finset.Ico 1 (β p.1) := (Finset.mem_sigma.mp hp).2
    have hj_le : p.2 ≤ M := le_trans (le_of_lt (Finset.mem_Ico.mp hp2).2) (hβ_hi p.1)
    simp only [clearedFactorSeries, PowerSeries.coeff_mk]
    exact ⟨Nat.cast_nonneg _, by exact_mod_cast clearedFactorCoeff_le (he_le p.1) hj_le⟩
  obtain ⟨hnn, hle⟩ := powerSeries_prod_coeff_bound S (fun p => clearedFactorSeries (e p.1) r p.2)
    (r ^ 2 * M) hfac_bd k
  rw [← hprod_eq] at hnn hle
  refine ⟨hnn, ?_⟩
  rw [abs_of_nonneg (by exact_mod_cast hnn)]
  have hS_card : S.card ≤ d * M := by
    dsimp only [S]
    rw [Finset.card_sigma]
    calc ∑ i : Fin d, (Finset.Ico 1 (β i)).card
        ≤ ∑ _i : Fin d, M := Finset.sum_le_sum (fun i _ => by simp; have := hβ_hi i; omega)
      _ = d * M := by simp
  have hchoose : Nat.choose (k + S.card) k ≤ (d * M + 1) ^ k :=
    le_trans (choose_add_le_pow S.card k) (Nat.pow_le_pow_left (by omega) k)
  have hle_z : PowerSeries.coeff k (clearedMonomialSeries r β e) ≤
      (((d * M + 1 : ℕ) : ℤ) ^ k) * ((r ^ 2 * M : ℕ) : ℤ) ^ k :=
    le_trans hle (mul_le_mul_of_nonneg_right (by exact_mod_cast hchoose) (by positivity))
  have hle_r : ((PowerSeries.coeff k (clearedMonomialSeries r β e) : ℤ) : ℝ) ≤
      (((d * M + 1 : ℕ) : ℝ) ^ k) * (((r ^ 2 * M : ℕ) : ℝ) ^ k) := by exact_mod_cast hle_z
  refine le_trans hle_r ?_
  push_cast
  rw [← mul_pow]
  have : ((d : ℝ) * (M : ℝ) + 1) * ((r : ℝ) ^ 2 * (M : ℝ)) =
      (r : ℝ) ^ 2 * ((d : ℝ) * (M : ℝ) + 1) * (M : ℝ) := by ring
  rw [this]

/-- **Concrete Canonical Monomial-Product Taylor Family (Eliminates `axiom canonicalMonomialTaylorFamily`)**:
Constructed directly from `clearedMonomialSeries` in `PowerSeries ℤ` with **zero external axioms**. -/
def canonicalMonomialTaylorFamily {d E r M : ℕ}
    (hd : 1 ≤ d) (hE : 1 ≤ E) (hr : 2 ≤ r) (hEr : E ≤ r - 1) (hM : 1 ≤ M)
    (β : Fin d → ℕ)
    (hβ_lo : ∀ i, r ≤ β i) (hβ_hi : ∀ i, β i ≤ M) (hβ_dvd : ∀ i, r ∣ β i)
    (hβ_mono : StrictMono β) :
    AlgebraicTaylorFamily (Nat.choose (d + E) d - 1) r M :=
  let hchoose_pos : 1 ≤ Nat.choose (d + E) d := Nat.choose_pos (by omega)
  let hcast : (Nat.choose (d + E) d - 1) + 1 = Nat.choose (d + E) d := Nat.sub_add_cancel hchoose_pos
  let idxToMulti : Fin ((Nat.choose (d + E) d - 1) + 1) → (Fin d → ℕ) :=
    fun i => (multiIndexEquiv d E (Fin.cast hcast i)).val
  { C_P := ((d * M + 1 : ℕ) : ℝ)
    C_P_pos := by exact_mod_cast (show 1 ≤ d * M + 1 by omega)
    clearedCoeff := fun i k => PowerSeries.coeff k (clearedMonomialSeries r β (idxToMulti i))
    f0_eq_one := by
      have h0 : idxToMulti 0 = fun _ => 0 := by
        dsimp only [idxToMulti]
        exact multiIndexEquiv_zero d E
      rw [h0, clearedMonomialSeries_zero]
      exact ⟨by simp, fun k hk => by cases k with | zero => omega | succ k => simp⟩
    coeff_bound := fun i k => by
      have he_mem := (multiIndexEquiv d E (Fin.cast hcast i)).property
      have he_le : ∀ j, idxToMulti i j ≤ r := by
        intro j
        have hj := (Finset.mem_filter.mp he_mem).1
        have hlt := Finset.mem_range.mp (Fintype.mem_piFinset.mp hj j)
        dsimp only [idxToMulti]
        omega
      exact (clearedMonomialSeries_coeff_bound β (idxToMulti i) hβ_hi he_le k).2 }

end GrasGreenbergBrocard
