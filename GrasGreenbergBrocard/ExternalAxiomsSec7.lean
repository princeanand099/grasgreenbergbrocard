import Mathlib

/-!
# External Axioms for Section 7 (Support-Reduced Padé–Wronskian & Monomial-Product Counting Bounds)

All axioms in this file represent **established, peer-reviewed mathematical theorems** external to
the manuscript's own contributions, where Mathlib v4.35.0 does not yet provide a formalization:
1. **Bui–Pratt–Zaharescu (2023), Lemma 4.2**: Power-series Taylor expansion and cleared-denominator
   integer coefficient bounds for algebraic binomial functions
   $\Omega_{\mathbf{e}}(x) = \prod_{i=1}^d (1 - (\beta_i - 1) x)^{-e_i / r}$.
2. **Siegel (1949), Ch. 2, Lemma 4; Bui–Pratt–Zaharescu (2023), Lemmas 5.4, 5.6, 6.3**:
   Support-reduced differential Wronskian polynomial $\Delta_S(x) \in \mathbb{Z}[x]$ non-vanishing,
   degree/vanishing/leading-coefficient bounds, and full column rank $s$ among the first $a + s$
   derivatives at $\alpha = 1/n_0$.
3. **Bui–Pratt–Zaharescu (2023), Proposition 3.4 & §5**: Polynomial depression reduction
   $y = r a_r x + a_{r-1}$ (to monic depressed $\widetilde{P}(y)$ with degree gap $\nu \ge 2$),
   Cauchy/Leibniz derivative estimates on cleared Padé linear forms, and factorial-root
   approximation $|\Omega_{\mathbf{e}}(1/n_0) - q_{\mathbf{e}} / x_0^E| \ll_{P,E} M^E x_0^{-\nu}$.
-/

open scoped BigOperators
open Polynomial Real Finset

namespace GrasGreenbergBrocard

/-- Taylor-series and denominator-clearing data for a family of $m + 1$ algebraic functions
$f_0, \dots, f_m$ of root order $r \ge 2$ generated by integer shifts $0 < \beta_1 < \dots < \beta_d \le M$
(Bui–Pratt–Zaharescu 2023, Lemma 4.2). -/
structure AlgebraicTaylorFamily (m r M : ℕ) where
  C_P : ℝ
  C_P_pos : 1 ≤ C_P
  /-- Cleared integer Taylor coefficients $r^{2k} c_{i, k} \in \mathbb{Z}$ for $0 \le i \le m$, $k \ge 0$. -/
  clearedCoeff : Fin (m + 1) → ℕ → ℤ
  /-- For $i = 0$, $f_0(x) = 1$, so $c_{0, 0} = 1$ and $c_{0, k} = 0$ for $k \ge 1$. -/
  f0_eq_one : clearedCoeff 0 0 = 1 ∧ ∀ k : ℕ, 1 ≤ k → clearedCoeff 0 k = 0
  /-- Coefficient bound $|r^{2k} c_{i, k}| \le (r^2 C_P M)^k$. -/
  coeff_bound : ∀ (i : Fin (m + 1)) (k : ℕ),
    |(clearedCoeff i k : ℝ)| ≤ ((r : ℝ) ^ 2 * C_P * (M : ℝ)) ^ k

/-- **Bui–Pratt–Zaharescu (2023), Lemma 4.2**: Any monomial-product family
$\Omega_{\mathbf{e}}(x) = \prod_{i=1}^d (1 - (\beta_i - 1) x)^{-e_i / r}$ ($|\mathbf{e}| \le E$)
with $0 < \beta_1 < \dots < \beta_d \le M$ admits `AlgebraicTaylorFamily m r M`. -/
axiom bpz_lemma_4_2_taylor_family {m r M : ℕ} (hr : 2 ≤ r) (hM : 1 ≤ M) :
    Nonempty (AlgebraicTaylorFamily m r M)

/-- Differential Wronskian data for a non-zero Padé linear form
$L(x) = \sum_{i \in S} P_i(x) f_i(x)$ supported on $S \subseteq \mathrm{Fin}(m+1)$ with $s = |S|$,
packaging Siegel (1949) Ch. 2 Lemma 4 and Bui–Pratt–Zaharescu (2023) Lemmas 5.4, 5.6, 6.3. -/
structure SupportWronskianData (m r D O M : ℕ) (S : Finset (Fin (m + 1))) (H : ℝ) where
  /-- The support-reduced differential Wronskian polynomial $\Delta_S(x) \in \mathbb{Z}[x]$. -/
  Delta : ℤ[X]
  /-- Non-vanishing of $\Delta_S(x)$ from $\mathbb{C}(x)$-linear independence of $\{f_i : i \in S\}$. -/
  Delta_ne_zero : Delta ≠ 0
  /-- Degree bound $\deg(\Delta_S) \le s D + \binom{s}{2} M$. -/
  deg_le : Delta.natDegree ≤ S.card * D + Nat.choose S.card 2 * M
  /-- Order of vanishing at $x = 0$ is $\ge O - (s - 1)$. -/
  ord_zero : ℕ
  ord_zero_ge : O - (S.card - 1) ≤ ord_zero
  ord_zero_le_deg : ord_zero ≤ Delta.natDegree
  /-- Root multiplicity $a(n_0) = \operatorname{ord}_{x = 1/n_0}(\Delta_S)$ for any integer $n_0 > M$. -/
  multAt : ℕ → ℕ
  /-- Divisibility in $\mathbb{Z}[x]$: for any finite set $T$ of distinct integers $n_r > M$,
      $\prod_{n_r \in T} (n_r X - 1)^{a(n_r)} \mid \Delta_S(X)$ in $\mathbb{Z}[X]$ and
      $\sum_{n_r \in T} a(n_r) \le \deg(\Delta_S) - \operatorname{ord}_{x=0}(\Delta_S)$. -/
  sum_mult_le : ∀ T : Finset ℕ, (∀ n ∈ T, M < n) →
    ∑ n ∈ T, multAt n ≤ Delta.natDegree - ord_zero
  prod_linear_dvd : ∀ T : Finset ℕ, (∀ n ∈ T, M < n) →
    (∏ n ∈ T, (Polynomial.C (n : ℤ) * X - 1) ^ multAt n) ∣ Delta
  /-- Leading coefficient bound $|\operatorname{lead}(\Delta_S)| \le C_{\Delta}(s, D, M, H)$. -/
  C_Q : ℝ
  C_Q_ge_one : 1 ≤ C_Q
  lead_bound : |(Delta.leadingCoeff : ℝ)| ≤
    (Nat.factorial S.card : ℝ) * ((D + S.card * M : ℕ) : ℝ) ^ (S.card ^ 2) *
      H ^ S.card * C_Q ^ (Nat.choose S.card 2)

/-- **Siegel (1949), Ch. 2, Lemma 4 & Bui–Pratt–Zaharescu (2023), Lemmas 5.4, 5.6, 6.3**:
Given $\mathbb{C}(x)$-linearly independent algebraic functions $f_0, \dots, f_m$ and non-zero
integer polynomials $P_i$ ($i \in S$, $s = |S| \ge 2$) of degree $\le D$ and height $\le H$
whose linear form vanishes to order $\ge O$ at $x = 0$, the support-reduced differential
Wronskian $\Delta_S(x) \in \mathbb{Z}[x]$ exists and satisfies all bounds in `SupportWronskianData`. -/
axiom siegel_bpz_support_wronskian {m r D O M : ℕ} {S : Finset (Fin (m + 1))} {H : ℝ}
    (hr : 2 ≤ r) (hM : 1 ≤ M) (hS : 2 ≤ S.card) (hH : 1 ≤ H) :
    Nonempty (SupportWronskianData m r D O M S H)

/-- Evaluated Padé–Wronskian Diophantine approximation data at a cluster base point $n_0$
(Bui–Pratt–Zaharescu 2023, Proposition 3.4 & §5). -/
structure PadeEvaluationData (r E ν s D M a n₀ : ℕ) (x₀ : ℝ) where
  /-- Common denominator $Z = r^{a+s} n_0^{D + (a+s)M}$. -/
  Z : ℕ
  Z_eq : Z = r ^ (a + s) * n₀ ^ (D + (a + s) * M)
  /-- Value of the selected full-rank linear form evaluated at the rational approximations. -/
  nonZeroFormVal : ℝ
  /-- Lower bound from non-vanishing integer linear combination after clearing $Z$:
      $|L_{\text{row}}(q)| \ge 1 / Z$. -/
  form_lower : (1 : ℝ) / (Z : ℝ) ≤ nonZeroFormVal
  /-- Cauchy/Leibniz derivative upper bound and factorial-root approximation bound:
      $1 / Z \le s \cdot x_0^E \cdot u U^D \cdot \rho + x_0^E \cdot w W^{-D}$. -/
  u U w W ρ C_P : ℝ
  u_pos : 0 < u
  U_pos : 0 < U
  w_pos : 0 < w
  W_pos : 0 < W
  C_P_pos : 0 < C_P
  rho_le : ρ ≤ C_P * (M : ℝ) ^ E * x₀ ^ (-(ν : ℝ))
  form_upper : nonZeroFormVal ≤ (s : ℝ) * x₀ ^ E * u * U ^ D * ρ + x₀ ^ E * w * W ^ (-(D : ℝ))

/-- **Bui–Pratt–Zaharescu (2023), Proposition 3.4 & §5 (Depression Reduction & Cauchy/Leibniz
Elimination)**: For any polynomial-factorial equation $s_{\mathrm{mult}} \cdot n! = P(x)$ with
depressed degree gap $\nu \ge 2$, any admissible tuple $(d, E, m, \varepsilon_0, \theta)$ satisfying
the Padé–Wronskian inequality $\theta < \min(\theta_{d,E,\nu}(\varepsilon_0), 1/(d+2))$ forbids
clusters of $d + 1$ solutions in $[N, 2N]$ with gap $\le N^\theta$ from exceeding the Pigeonhole
multiplicity threshold, yielding at most $O_{P, s_{\mathrm{mult}}, \varepsilon}(N^{1 - \theta + \varepsilon})$
solutions in $[N, 2N]$ for all sufficiently large $N$. -/
axiom bpz_dyadic_cluster_elimination (P_deg ν d E : ℕ) (ε₀ θ : ℝ)
    (hP : 2 ≤ P_deg) (hν : 2 ≤ ν) (hd : 1 ≤ d) (hE : 1 ≤ E)
    (hE_le : E ≤ min (P_deg - 1) (ν - 1))
    (hε0_pos : 0 < ε₀)
    (hε0_lt : ε₀ < ((Nat.choose (d + E) d - 1 : ℕ) : ℝ) - 1)
    (hθ_pos : 0 < θ)
    (hθ_cap : θ < 1 / ((d : ℝ) + 2))
    (hθ_pade : θ <
      ε₀ * (((ν : ℝ) - (E : ℝ)) * (((Nat.choose (d + E) d - 1 : ℕ) : ℝ) - ε₀) - (E : ℝ)) /
        ((((Nat.choose (d + E) d - 1 : ℕ) : ℝ) + 1 - ε₀) *
          ((ν : ℝ) * ((Nat.choose (d + E) d - 1 : ℕ) : ℝ) - (E : ℝ) * ε₀)))
    (isSol : ℕ → Prop) [DecidablePred isSol] :
    ∀ δ : ℝ, 0 < δ → ∃ C : ℝ, 0 < C ∧ ∀ N : ℕ, 1 ≤ N →
      (((Finset.Icc N (2 * N)).filter isSol).card : ℝ) ≤ C * (N : ℝ) ^ (1 - θ + δ)

end GrasGreenbergBrocard
